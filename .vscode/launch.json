{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Teachers UPC - Web (app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "Plataforma Docentes - consola (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        }
    ]
}